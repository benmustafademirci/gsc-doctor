# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Optional: enables the Gemini summary and title suggestions.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: path to a service account key (instead of --credentials).
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Optional: default property (instead of --site).
# GSC_SITE=sc-domain:example.com
